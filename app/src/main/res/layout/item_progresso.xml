<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/progresso_card_stroke"
    app:cardBackgroundColor="@color/progresso_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Data + Peso (separado e bonito) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDataPeso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="12/02/2026 | 80.0 kg"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/progresso_text_primary" />

            <!-- (opcional) um “badge” verde de destaque -->
            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REGISTRO"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textColor="@color/progresso_badge_text" />

        </LinearLayout>

        <!-- Fotos (some se não tiver) -->
        <LinearLayout
            android:id="@+id/rowFotos"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgFrente"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_photo_thumb"
                android:clipToOutline="true"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/imgLado"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_photo_thumb"
                android:clipToOutline="true"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/imgCostas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_photo_thumb"
                android:clipToOutline="true"/>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
