<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_neon_card">

    <TextView
        android:id="@+id/tvAlunoNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aluno"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/tvAlunoEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="email"
        android:textColor="@color/text_secondary"
        android:paddingTop="2dp"/>

    <TextView
        android:id="@+id/tvAlunoStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status"
        android:textColor="@color/green_primary"
        android:paddingTop="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnRemoverVinculo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_elevated"
            android:textColor="@color/ex_border_error"
            android:text="Remover vínculo" />

        <LinearLayout
            android:layout_width="10dp"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnToggleAlunoAtivo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_elevated"
            android:textColor="@color/text_primary"
            android:text="Desativar" />
    </LinearLayout>

</LinearLayout>
