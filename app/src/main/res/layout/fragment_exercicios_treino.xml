<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background">

    <!-- TÍTULO (igual telas anteriores) -->
    <TextView
        android:id="@+id/tvTituloTreino"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Treino"
        android:textSize="34sp"
        android:textColor="@color/green_primary"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"/>

    <!-- BOTÃO VERDE (Adicionar exercício) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdicionarExercicio"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Adicionar exercício"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="10dp"
        app:backgroundTint="@color/green_primary"
        app:cornerRadius="18dp"
        app:elevation="0dp"/>

    <!-- BOTÃO VERDE (Apagar treino) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApagarTreino"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Apagar treino"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="10dp"
        app:backgroundTint="@color/green_primary"
        app:cornerRadius="18dp"
        app:elevation="0dp"/>

    <!-- LISTA -->
    <ListView
        android:id="@+id/listExercicios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:layout_marginTop="6dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalvarTreino"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Salvar"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="12dp"
        app:backgroundTint="@color/green_primary"
        app:cornerRadius="18dp"
        app:elevation="0dp"/>
</LinearLayout>
