<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardDia"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_margin="8dp"
    android:background="@drawable/bg_card_cardio">

    <TextView
        android:id="@+id/tvDiaTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SEG 04/02"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#2F4F4F"
        android:fontFamily="sans-serif-medium"/>

    <TextView
        android:id="@+id/tvDiaResumo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 cardio • 0 min"
        android:textSize="13sp"
        android:textColor="#3E3E3E"
        android:paddingTop="6dp"/>

    <TextView
        android:id="@+id/tvDiaTipos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="13sp"
        android:textColor="#555555"
        android:paddingTop="4dp"/>

    <TextView
        android:id="@+id/tvDiaRitmo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ritmo: —"
        android:textSize="12sp"
        android:textColor="#6A6A6A"
        android:paddingTop="4dp"/>

</LinearLayout>
