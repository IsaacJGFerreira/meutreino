<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="146dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_neon_card">

    <TextView
        android:id="@+id/tvDiaTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SEG"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:letterSpacing="0.06"
        android:fontFamily="sans-serif-medium"/>

    <TextView
        android:id="@+id/tvDiaMinutos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="30 min"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="duração registrada"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"/>

    <LinearLayout
        android:id="@+id/viewBarTrack"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_cardio_progress_track"
        android:clipToOutline="true"
        android:padding="0dp">

        <View
            android:id="@+id/viewBarFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="@drawable/bg_cardio_progress_fill"/>

        <View
            android:id="@+id/viewBarRemainder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>
