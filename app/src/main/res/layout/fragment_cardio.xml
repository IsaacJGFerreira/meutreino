<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#DEEFE4"
    android:padding="16dp">

    <!-- Topo: semana + setas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSemanaAnterior"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="‹"
            android:textColor="@android:color/white"
            app:cornerRadius="14dp"
            app:backgroundTint="#5AAB8A"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <TextView
            android:id="@+id/tvSemanaAtual"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Semana: --/-- - --/--"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5AAB8A"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProximaSemana"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="›"
            android:textColor="@android:color/white"
            app:cornerRadius="14dp"
            app:backgroundTint="#5AAB8A"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>

    <!-- Lista (grid) dos dias -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSemana"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp"/>

    <!-- Total da semana -->
    <TextView
        android:id="@+id/tvTotalSemana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total da semana: 0 min"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#5AAB8A"
        android:layout_marginBottom="10dp"
        android:fontFamily="sans-serif-medium"/>

    <!-- Botão registrar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdicionarCardio"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Registrar Cardio"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        app:cornerRadius="18dp"
        app:backgroundTint="#5AAB8A"/>
</LinearLayout>
