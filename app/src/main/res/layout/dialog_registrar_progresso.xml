<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/bg_neon_card">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrar Progresso"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etPesoDialog"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Peso (kg)"
        android:inputType="numberDecimal"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_neon_input"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fotos (opcional)"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"/>

    <!-- ✅ ordem igual print: Frente / Costas / Lado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/cardFrente"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_photo_card_dark"/>

        <FrameLayout
            android:id="@+id/cardCostas"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_photo_card_dark"/>

        <FrameLayout
            android:id="@+id/cardLado"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:background="@drawable/bg_photo_card_dark"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalvarDialog"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Salvar"
        android:textAllCaps="false"
        android:background="@drawable/bg_neon_button"
        android:textColor="@color/background_deep"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:backgroundTint="@null"
        app:cornerRadius="18dp"/>


</LinearLayout>
