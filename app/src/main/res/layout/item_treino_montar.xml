<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTreino"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/neon_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvNomeTreinoItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Treino A - Pernas"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMoverTreinoCima"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_neon_pill"
                android:contentDescription="Mover treino para cima"
                android:focusable="false"
                android:src="@android:drawable/arrow_up_float"
                android:tint="@color/green_primary" />

            <ImageButton
                android:id="@+id/btnMoverTreinoBaixo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_neon_pill"
                android:contentDescription="Mover treino para baixo"
                android:focusable="false"
                android:src="@android:drawable/arrow_down_float"
                android:tint="@color/green_primary" />

            <ImageButton
                android:id="@+id/btnEditarNomeTreino"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_neon_pill"
                android:contentDescription="Editar nome do treino"
                android:focusable="false"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="@color/green_primary" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
