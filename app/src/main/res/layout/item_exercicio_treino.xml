<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/neon_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- COLUNA ESQUERDA: textos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeExercicioItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agachamento"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <!-- ⚠️ NÃO REMOVER: usado pelo ExerciciosListAdapter -->
            <TextView
                android:id="@+id/tvMetasExercicioItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Séries: 3 | Reps: 8-10 | Desc: 90s | RIR: 1-2 | Técnica: —"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- COLUNA DIREITA: botões de ordem -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <ImageButton
                android:id="@+id/btnMoverCima"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_neon_pill"
                android:contentDescription="Mover para cima"
                android:src="@android:drawable/arrow_up_float" />

            <ImageButton
                android:id="@+id/btnMoverBaixo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_neon_pill"
                android:contentDescription="Mover para baixo"
                android:src="@android:drawable/arrow_down_float" />

            <!-- Opcional: botão de menu (Topo / Final). Se não quiser agora, pode apagar -->
            <ImageButton
                android:id="@+id/btnMenuOrdem"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_neon_pill"
                android:contentDescription="Mais opções"
                android:src="@android:drawable/ic_menu_more" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
