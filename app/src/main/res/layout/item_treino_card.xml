<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTreino"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="8dp"
    app:cardBackgroundColor="#FEFEFE"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Cabeçalho do Treino -->
        <LinearLayout
            android:id="@+id/headerTreino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/tvNomeTreino"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LEGS A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#64898A"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/tvSetaTreino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌄"
                android:textSize="18sp"
                android:textColor="#64898A"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <!-- Container expansível -->
        <LinearLayout
            android:id="@+id/containerExercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="8dp"/>

        <!-- Botão salvar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvarTreino"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Salvar treino"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/green_primary"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
