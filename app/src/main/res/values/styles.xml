<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppGreenButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">54dp</item>
        <item name="android:textColor">@color/background_deep</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>

        <!-- Arredondado -->
        <item name="cornerRadius">20dp</item>

        <!-- Vamos usar nosso drawable e NÃO deixar o Material pintar por cima -->
        <item name="android:background">@drawable/bg_button_green</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="NeonScreenTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="NeonSectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>



    <style name="ThemeOverlay.MeuTreino.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="backgroundTint">@color/surface</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MeuTreino.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MeuTreino.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.MeuTreino.DialogButton</item>
    </style>

    <style name="Widget.MeuTreino.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/green_primary</item>
    </style>

</resources>
